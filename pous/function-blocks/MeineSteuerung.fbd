    xOUT3 : BOOL; (* LED2 *)
    xOUT4 : BOOL; (* LED3 *)
    xOUT5 : BOOL; (* LED4 *)
    xOUT6 : BOOL; (* LED5 *)
    xOUT7 : BOOL; (* LED6 *)
    xOUT8 : BOOL; (* LED7 *)
    iDAC1 : USINT; (* DAC1 *)
    iDAC2 : USINT; (* DAC2 *)
  END_VAR
  VAR_INPUT
    xIN1 : BOOL; (* S1 *)
    xIN2 : BOOL; (* S2 *)
    xIN3 : BOOL; (* S3 *)
    xIN4 : BOOL; (* S4 *)
    iADC0 : UINT;
    iADC1 : UINT;
    iADC2 : UINT;
    iADC3 : UINT; (* A3: Poti oder LDR *)
  END_VAR
  VAR_GLOBAL CONSTANT
END_VAR

  VAR_EXTERNAL
    NOTE_C : INT;
    NOTE_Cs : INT;
