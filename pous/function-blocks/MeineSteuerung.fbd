    NOTE_Eb : INT;
    NOTE_E : INT;
    NOTE_F : INT;
    NOTE_Fs : INT;
    NOTE_G : INT;
    NOTE_Gs : INT;
    NOTE_A : INT;
    NOTE_Bb : INT;
    NOTE_B : INT;
  END_VAR
  VAR_INPUT CONSTANT
  END_VAR
  VAR_EXTERNAL CONSTANT
  END_VAR

